# The C++ style: KDE's Frameworks coding style (WebKit's, with KDE's
# changes), keeping short inline functions on one line and long calls packed
# within 140 columns. Check with `clang-format --dry-run --Werror`.
# https://community.kde.org/Policies/Frameworks_Coding_Style
---
Language: Cpp
BasedOnStyle: WebKit
Standard: Latest
ColumnLimit: 140
SortIncludes: CaseSensitive
BreakBeforeBraces: Linux
PointerAlignment: Right
AlignAfterOpenBracket: Align
AlignTrailingComments:
  Kind: Leave
AlwaysBreakBeforeMultilineStrings: true
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortEnumsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
BreakBeforeBinaryOperators: NonAssignment
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
KeepEmptyLinesAtTheStartOfBlocks: false
NamespaceIndentation: None
SpaceAfterTemplateKeyword: false
AlwaysBreakTemplateDeclarations: true
ForEachMacros: [Q_FOREACH, forever, Q_FOREVER, QBENCHMARK, QBENCHMARK_ONCE]
