# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 gfxtune contributors

# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[LICENSES/**]
indent_style = unset
indent_size = unset

# Arch Linux's own convention for package files.
[PKGBUILD]
indent_size = 2

# Readings saved exactly as the card's files gave them.
[tests/data/**]
trim_trailing_whitespace = false
