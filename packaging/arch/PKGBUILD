# Builds gfxtune from the source folder this file belongs to.
# From this folder:  makepkg -si
# Remove with:       sudo pacman -R gfxtune

pkgname=gfxtune
pkgver=0.5.0
pkgrel=1
pkgdesc='Graphics and game tuning for Steam games, with in-game filters and GPU readings'
url='https://github.com/gfxtune/gfxtune'
arch=('x86_64')
license=('GPL-3.0-or-later')
# No link-time optimisation: GCC 16.2 with LTO (CachyOS's default) turns
# Qt's QStringView::compare() in a loop into a jump to unrelated code, which
# broke the Steam file readers. A 30-line program without gfxtune's code
# shows it; -fno-ipa-cp or -fno-thread-jumps hide it. check() catches it.
options=('!debug' '!lto')
# kquickcharts, qqc2-desktop-style (QML) and libdrm (its list of card names)
# are used at run time, where namcap cannot see them.
depends=('bash' 'glibc' 'hicolor-icon-theme' 'kirigami' 'ki18n' 'kquickcharts' 'libdrm' 'libgcc' 'libstdc++'
         'qqc2-desktop-style' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'glslang' 'vulkan-headers' 'vulkan-icd-loader')
optdepends=('gamescope: run games in gamescope, with upscaling and frame caps for any game'
            'gamemode: switch GameMode on for games'
            'mangohud: switch MangoHud on for games'
            'proton-cachyos: the FSR 4 upgrade and other Proton features')

_source() {
  realpath "$startdir/../.."
}

build() {
  # --fresh: never reuse settings from an earlier build in this folder.
  cmake --fresh -S "$(_source)" -B build -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -Wno-dev
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$startdir/gfxtune.hook" "$pkgdir/usr/share/libalpm/hooks/gfxtune.hook"
  install -Dm755 "$startdir/remove-launch-lines" "$pkgdir/usr/share/gfxtune/remove-launch-lines"
  install -Dm644 "$(_source)/NOTICE.md" "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
